# Optional: Kakao Developers JavaScript key. Register the production web domain.
NEXT_PUBLIC_KAKAO_JS_KEY=
# Optional: custom k-skill proxy host; default is the public k-skill proxy.
KSKILL_PROXY_BASE_URL=https://k-skill-proxy.nomadamas.org
# Optional: alternative map provider. Supply its attribution as plain text.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Optional: canonical site URL for a custom domain, including https://.
NEXT_PUBLIC_SITE_URL=
